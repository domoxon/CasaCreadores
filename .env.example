# Casa Creadores — variables de entorno
# Local: copia este archivo a .env en la raíz del repo.
# Producción: se configuran en Vercel (Project → Settings → Environment Variables).

# --- Base de datos (PostgreSQL) ---
# En Vercel las crea la integración de Neon automáticamente.
# En local, con docker compose, usa la misma URL en las dos.
DATABASE_URL="postgresql://user:password@localhost:5432/casa_creadores?schema=public"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/casa_creadores?schema=public"

# --- Auth (OBLIGATORIAS, largas y distintas entre sí) ---
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-largo-y-aleatorio"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Cuentas internas de producción (las crea el build si no existen) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
OPS_EMAIL=""
OPS_PASSWORD=""

# --- Email (Resend) ---
# Sin dominio verificado en Resend, deja EMAIL_FROM vacío (usa onboarding@resend.dev) y
# Resend solo entregará al email con el que creaste la cuenta de Resend.
RESEND_API_KEY=""
ADMIN_NOTIFY_EMAIL=""
PUBLIC_SITE_URL="http://localhost:5173"

# --- Opcionales ---
# Dominio propio para CORS y enlaces de email (la web llama a /api en su mismo origen, no hace falta en Vercel).
FRONTEND_URL="http://localhost:5173"
# Email: dejar vacío. La verificación por email está desactivada hasta integrar un proveedor real.
EMAIL_FROM="Casa Creadores <no-reply@casacreadores.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Pagos USDC (Circle) — sin esto los pagos funcionan en modo mock.
CIRCLE_API_KEY=""
CIRCLE_API_URL="https://api-sandbox.circle.com"

# --- Frontend (Vite, se congelan en el build) ---
# No hacen falta: en local la web usa http://localhost:4000/api y en Vercel usa /api.
VITE_API_URL=""
VITE_SOCIAL_X=""
VITE_SOCIAL_LINKEDIN=""
VITE_SOCIAL_INSTAGRAM=""
VITE_CONTACT_EMAIL=""
