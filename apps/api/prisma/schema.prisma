generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: DATABASE_URL es la conexión con pooler (para la app);
  // DATABASE_URL_UNPOOLED es la directa (para migraciones). En local pon la misma en ambas.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  MARCA
  CREADOR
  ADMIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum VerifiedStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  password               String
  role                   UserRole
  emailVerified          Boolean   @default(false)
  verificationToken      String?   @unique
  verificationExpiresAt  DateTime?
  refreshToken           String?
  createdAt              DateTime  @default(now())

  brand   Brand?
  creator Creator?
}

model Brand {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  website     String
  industry    String
  createdAt   DateTime @default(now())

  campaigns Campaign[]
  payments  Payment[]
}

model Creator {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String         @default("")
  xHandle        String?
  igHandle       String?
  tiktokHandle   String?
  verifiedStatus VerifiedStatus @default(PENDING)
  followerCount  Int            @default(0)
  nichos         String[]       @default([])
  createdAt      DateTime       @default(now())

  // Datos de cobro que el propio creador mantiene en su panel.
  // payoutMethod: CRYPTO | BINANCE_PAY | BANK | WISE · payoutDetails: campos según el método.
  payoutMethod    String?
  payoutDetails   Json?
  payoutUpdatedAt DateTime?

  applications CampaignApplication[]
}

model Campaign {
  id                String         @id @default(uuid())
  brandId           String
  brand             Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title             String
  description       String
  budgetUSDC        Float
  duration          Int
  minFollowers      Int            @default(0)
  minEngagementRate Float          @default(0)
  status            CampaignStatus @default(DRAFT)
  createdAt         DateTime       @default(now())

  // Ficha pública de la campaña (la crea el equipo desde /admin/campanas).
  // brandName/brandWebsite = la marca cliente que se muestra; brandId apunta a la cuenta
  // interna de operaciones que "posee" la campaña en la base de datos.
  brandName         String?
  brandWebsite      String?
  brandLogoUrl      String?
  coverImageUrl     String?
  brandContext      String         @default("")
  deliverables      String         @default("")
  requirements      String         @default("")
  socialLinks       Json?
  platforms         String[]       @default([])
  countries         String[]       @default([])
  nichos            String[]       @default([])
  paymentPerCreator Float?
  spots             Int?
  startDate         DateTime?
  endDate           DateTime?
  publishedAt       DateTime?

  applications CampaignApplication[]
  payments     Payment[]
}

model CampaignApplication {
  id         String            @id @default(uuid())
  campaignId String
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status     ApplicationStatus @default(PENDING)
  appliedAt  DateTime          @default(now())

  // Pago al creador por esta campaña (lo gestiona el equipo).
  payoutAmount    Float?
  payoutStatus    PayoutStatus @default(NOT_DUE)
  payoutReference String?
  paidAt          DateTime?

  submissions ContentSubmission[]

  @@unique([campaignId, creatorId])
}

enum PayoutStatus {
  NOT_DUE
  DUE
  PAID
}

enum SubmissionStatus {
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  VERIFIED
}

// Entrega de contenido de un creador seleccionado. El archivo vive en su Drive/Dropbox
// (contentUrl); cuando el equipo aprueba, el creador pega el enlace del post publicado
// (postUrl) y el equipo lo verifica. Cada nueva versión es una fila nueva.
model ContentSubmission {
  id            String              @id @default(uuid())
  applicationId String
  application   CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contentUrl    String?
  // Enlaces por destino: draft (Drive/Dropbox) y posts publicados por red (x, instagram,
  // tiktok, youtube, linkedin, twitch, other).
  links         Json?
  notes         String              @default("")
  postUrl       String?
  status        SubmissionStatus    @default(SUBMITTED)
  feedback      String?
  createdAt     DateTime            @default(now())
  reviewedAt    DateTime?
  publishedAt   DateTime?

  @@index([applicationId])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Payment {
  id         String        @id @default(uuid())
  brandId    String
  brand      Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  amountUSDC Float
  txHash     String?
  status     PaymentStatus @default(PENDING)
  createdAt  DateTime      @default(now())
}

enum ApplicationReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Solicitud para entrar a la red. Nadie tiene cuenta de creador sin una solicitud aprobada:
// el equipo revisa (enlace por email -> /revisar/:reviewToken) y, si aprueba, el creador
// recibe un enlace de activación (/activar/:inviteToken) para crear su contraseña.
model CreatorApplication {
  id              String                  @id @default(uuid())
  name            String
  email           String
  country         String
  languages       String[]                @default([])
  contact         String
  platforms       Json
  followerCount   Int                     @default(0)
  nichos          String[]                @default([])
  contentTypes    String[]                @default([])
  payoutMethod    String
  bestPosts       String                  @default("")
  bio             String                  @default("")
  referredBy      String?
  status          ApplicationReviewStatus @default(PENDING)
  reviewToken     String                  @unique
  inviteToken     String?                 @unique
  inviteExpiresAt DateTime?
  reviewedAt      DateTime?
  activatedAt     DateTime?
  userId          String?
  createdAt       DateTime                @default(now())

  @@index([email])
}
